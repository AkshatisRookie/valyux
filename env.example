# Copy this file to .env and add your keys.

# Google Analytics 4 — Measurement ID: Admin → Data streams → Web (format G-XXXXXXXXXX).
# Set the same in Vercel Environment Variables and redeploy. Leave empty to disable.
GA_MEASUREMENT_ID=

# Optional affiliate base URLs for grocery platform deep links.
AFFILIATE_JIOMART=https://www.jiomart.com
AFFILIATE_BLINKIT=https://blinkit.com
AFFILIATE_INSTAMART=https://www.swiggy.com/instamart
AFFILIATE_ZEPTO=https://www.zepto.com

# Backend API for QuickCommerce proxy, geocoding, pincode lookup.
# Local: cd backend && npm run dev
VALYUX_API_URL=http://localhost:8080

# --- Production (valyux.in) — set these in Vercel “Environment Variables” and rebuild ---
# Frontend bundle: must be a public HTTPS URL (never localhost). Mobile browsers use this
# exact host; localhost would point at the phone, not your server.
# VALYUX_API_URL=https://api.valyux.in
#   …or your Railway public URL, e.g. https://xxxx.up.railway.app
#
# Backend (Railway service env): allow the real site origin(s) for CORS (comma-separated, no trailing slash).
# FRONTEND_URL=https://valyux.in,https://www.valyux.in
