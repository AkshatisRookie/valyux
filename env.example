# Copy this file to .env and add your keys.

# Gemini API key (optional — Smart Cart AI summary; without it we use a local fallback)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# BigBasket: URL for the logo on the grocery home page (“Comparing from”). Product search still uses bigbasket.com.

AFFILIATE_BIGBASKET=https://www.bigbasket.com
AFFILIATE_BLINKIT=https://blinkit.com
AFFILIATE_INSTAMART=https://www.swiggy.com/instamart
AFFILIATE_ZEPTO=https://www.zepto.com

# EarnKaro Affiliate Link Generation (for Electronics & Devices section)
# Your EarnKaro Sub-ID for tracking affiliate link conversions.
# Leave empty to generate links without a sub-ID.
EARNKARO_SUB_ID=

# Backend API URL for Commerce proxy, address autocomplete, pincode geocode
# Start the backend with: cd backend && npm run dev
VALYUX_API_URL=http://localhost:8080

# (Legacy) QcomPl — only if you still use old grocery routes
QCOMPL_API_URL=http://148.113.1.102:6893
QCOMPL_API_KEY=
